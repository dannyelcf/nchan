# .env file for Docker Compose
# These are default values that can be overridden

# Nchan configuration
REBUILD=false
NCHAN_SHARED_MEMORY_SIZE=128M

# Redis configuration  
REDIS_MEMORY_LIMIT=256mb

# Load testing configuration
NCHAN_HOST=nchan:80
CHANNEL=test
DURATION=30
CONNECTIONS=100
RATE=1000

# Logging
LOG_LEVEL=info

# Development settings
DEV_MODE=true