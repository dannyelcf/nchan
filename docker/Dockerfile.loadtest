# Load testing and benchmarking Dockerfile
FROM alpine:latest

# Install load testing tools
RUN apk add --no-cache \
    curl \
    wget \
    wrk \
    apache2-utils \
    nodejs \
    npm \
    python3 \
    py3-pip \
    py3-websockets \
    py3-requests \
    py3-aiohttp \
    bash \
    git

# Install additional tools
RUN npm install -g artillery ws wscat

# Create scripts directory
RUN mkdir -p /scripts

# Scripts will be mounted from dev/bench/ via docker-compose volume mount
# This ensures we use the existing, maintained scripts instead of duplicates

# Make common scripts executable (mounted via volume)
# RUN chmod +x /scripts/*.py /scripts/*.sh || true

WORKDIR /scripts

CMD ["tail", "-f", "/dev/null"]