# Load testing and benchmarking Dockerfile
FROM alpine:latest

# Install load testing tools
RUN apk add --no-cache \
    curl \
    wget \
    wrk \
    apache2-utils \
    nodejs \
    npm \
    python3 \
    py3-pip \
    py3-websockets \
    py3-requests \
    py3-aiohttp \
    bash \
    git

# Install additional tools
RUN npm install -g artillery ws wscat

# Create scripts directory
RUN mkdir -p /scripts

# Copy benchmarking scripts if they exist
# COPY dev/bench/ /scripts/

# Copy external load testing scripts
COPY docker/loadtest/websocket-test.py /scripts/websocket-test.py
COPY docker/loadtest/http-bench.sh /scripts/http-bench.sh
COPY docker/loadtest/publish.lua /scripts/publish.lua
COPY docker/nchan_ws_test.py /scripts/nchan_ws_test.py

# Make scripts executable
RUN chmod +x /scripts/websocket-test.py /scripts/http-bench.sh /scripts/nchan_ws_test.py

WORKDIR /scripts

CMD ["tail", "-f", "/dev/null"]